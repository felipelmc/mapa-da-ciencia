{
  "name": "mapa-da-ciencia-frontend",
  "private": true,
  "version": "2.0.0",
  "description": "Interface do mapa-da-ciencia: visualiza os arquivos do contrato de dados gerados pelo pipeline em Python.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/relativizar-index.ts build",
    "preview": "vite preview",
    "empacotar": "npm run build && node scripts/empacotar.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "tipos": "node scripts/gerar-tipos.ts",
    "tipos:checar": "node scripts/gerar-tipos.ts --checar",
    "prepare": "svelte-kit sync || echo ''",
    "e2e:pagina": "playwright test -c playwright.pagina.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-contour": "3.0.6",
    "@types/d3-geo": "3.1.1",
    "@types/d3-quadtree": "3.0.6",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.0",
    "@types/topojson-client": "3.1.5",
    "gifenc": "1.0.3",
    "json-schema-to-typescript": "16.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "d3-array": "3.2.4",
    "d3-contour": "4.0.2",
    "d3-geo": "3.1.1",
    "d3-quadtree": "3.0.1",
    "d3-shape": "3.2.0",
    "minisearch": "7.2.0",
    "regl-scatterplot": "1.16.0",
    "topojson-client": "3.1.0"
  }
}
