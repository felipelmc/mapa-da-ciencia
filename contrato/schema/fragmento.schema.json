{
  "$defs": {
    "Detalhe": {
      "additionalProperties": false,
      "description": "O que a interface mostra ao abrir um documento: resumo, autores, licença e evidências.",
      "properties": {
        "autores": {
          "items": {
            "type": "string"
          },
          "title": "Autores",
          "type": "array"
        },
        "evidencias": {
          "additionalProperties": {
            "$ref": "#/$defs/Evidencia"
          },
          "title": "Evidencias",
          "type": "object"
        },
        "fonte_analise": {
          "anyOf": [
            {
              "enum": [
                "resumo",
                "reserva",
                "so_titulo"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`resumo`: título e resumo no idioma de análise; `reserva`: resumo em outro idioma (não havia no de análise); `so_titulo`: o documento não tem resumo. O texto em si não é publicado.",
          "title": "Fonte Analise"
        },
        "idioma": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idioma"
        },
        "idioma_analise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Idioma do texto usado nos embeddings e nos tópicos.",
          "title": "Idioma Analise"
        },
        "licenca": {
          "title": "Licenca",
          "type": "string"
        },
        "licenca_fonte": {
          "title": "Licenca Fonte",
          "type": "string"
        },
        "palavras_chave": {
          "items": {
            "type": "string"
          },
          "title": "Palavras Chave",
          "type": "array"
        },
        "resumo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None quando a licença não permite publicar o resumo.",
          "title": "Resumo"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "resumo",
        "idioma",
        "autores",
        "url",
        "licenca",
        "licenca_fonte"
      ],
      "title": "Detalhe",
      "type": "object"
    },
    "Evidencia": {
      "additionalProperties": false,
      "description": "Valor de uma variável do codebook e o trecho do resumo que o justifica.",
      "properties": {
        "evidencia": {
          "title": "Evidencia",
          "type": "string"
        },
        "fim": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fim"
        },
        "inicio": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Posição do trecho no resumo exibido (caracteres), se localizado.",
          "title": "Inicio"
        },
        "status": {
          "enum": [
            "literal",
            "aproximada",
            "ausente"
          ],
          "title": "Status",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valor"
        }
      },
      "required": [
        "valor",
        "evidencia",
        "status"
      ],
      "title": "Evidencia",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Um dos 64 fragmentos de detalhes, carregados sob demanda.",
  "properties": {
    "documentos": {
      "additionalProperties": {
        "$ref": "#/$defs/Detalhe"
      },
      "title": "Documentos",
      "type": "object"
    },
    "fragmento": {
      "title": "Fragmento",
      "type": "string"
    },
    "versao_contrato": {
      "default": "1.1",
      "description": "Versão do contrato. Versões 1.x só acrescentam campos: quem lê 1.0 lê qualquer 1.x.",
      "pattern": "^1\\.\\d+$",
      "title": "Versao Contrato",
      "type": "string"
    }
  },
  "required": [
    "fragmento",
    "documentos"
  ],
  "title": "Fragmento",
  "type": "object"
}
