{
  "$defs": {
    "DecisaoJuri": {
      "additionalProperties": false,
      "description": "Como o júri decidiu uma variável de um documento da amostra de validação.",
      "properties": {
        "etapa": {
          "enum": [
            "unanime",
            "maioria",
            "deliberacao",
            "sem_maioria"
          ],
          "title": "Etapa",
          "type": "string"
        },
        "justificativa": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A justificativa do supervisor (vazia no site publicado).",
          "title": "Justificativa"
        },
        "supervisor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quem arbitrou, quando não houve maioria.",
          "title": "Supervisor"
        },
        "valor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "A decisão final (com o supervisor, se ele decidiu).",
          "title": "Valor"
        },
        "valor_sem_supervisor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valor Sem Supervisor"
        },
        "virou": {
          "default": false,
          "description": "A deliberação mudou a decisão (outra maioria, ou antes não havia).",
          "title": "Virou",
          "type": "boolean"
        },
        "votos": {
          "items": {
            "$ref": "#/$defs/VotoJuri"
          },
          "title": "Votos",
          "type": "array"
        }
      },
      "required": [
        "etapa",
        "valor",
        "valor_sem_supervisor"
      ],
      "title": "DecisaoJuri",
      "type": "object"
    },
    "Detalhe": {
      "additionalProperties": false,
      "description": "O que a interface mostra ao abrir um documento: resumo, autores, licença e evidências.",
      "properties": {
        "autores": {
          "items": {
            "type": "string"
          },
          "title": "Autores",
          "type": "array"
        },
        "evidencias": {
          "additionalProperties": {
            "$ref": "#/$defs/Evidencia"
          },
          "title": "Evidencias",
          "type": "object"
        },
        "fonte_analise": {
          "anyOf": [
            {
              "enum": [
                "resumo",
                "reserva",
                "so_titulo"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`resumo`: título e resumo no idioma de análise; `reserva`: resumo em outro idioma (não havia no de análise); `so_titulo`: o documento não tem resumo. O texto em si não é publicado.",
          "title": "Fonte Analise"
        },
        "idioma": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idioma"
        },
        "idioma_analise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Idioma do texto usado nos embeddings e nos tópicos.",
          "title": "Idioma Analise"
        },
        "juri": {
          "additionalProperties": {
            "$ref": "#/$defs/DecisaoJuri"
          },
          "description": "Variável → decisão do júri (só nos documentos da amostra, com júri).",
          "title": "Juri",
          "type": "object"
        },
        "licenca": {
          "title": "Licenca",
          "type": "string"
        },
        "licenca_fonte": {
          "title": "Licenca Fonte",
          "type": "string"
        },
        "palavras_chave": {
          "items": {
            "type": "string"
          },
          "title": "Palavras Chave",
          "type": "array"
        },
        "resumo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None quando a licença não permite publicar o resumo.",
          "title": "Resumo"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "resumo",
        "idioma",
        "autores",
        "url",
        "licenca",
        "licenca_fonte"
      ],
      "title": "Detalhe",
      "type": "object"
    },
    "Evidencia": {
      "additionalProperties": false,
      "description": "Valor de uma variável do codebook e o trecho do resumo que o justifica.",
      "properties": {
        "campo": {
          "anyOf": [
            {
              "enum": [
                "titulo",
                "resumo"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Onde o trecho foi localizado; `inicio` e `fim` são posições nesse texto.",
          "title": "Campo"
        },
        "evidencia": {
          "title": "Evidencia",
          "type": "string"
        },
        "fim": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fim"
        },
        "inicio": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Posição do trecho no resumo exibido, se localizado, em pontos de código Unicode (como o Python conta; em JavaScript, converta para UTF-16).",
          "title": "Inicio"
        },
        "status": {
          "description": "`literal`: o trecho está no texto; `aproximada`: quase (90% dos caracteres); `ausente`: não está; `dispensada`: vazia numa resposta sem informação.",
          "enum": [
            "literal",
            "aproximada",
            "ausente",
            "dispensada"
          ],
          "title": "Status",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valor"
        }
      },
      "required": [
        "valor",
        "evidencia",
        "status"
      ],
      "title": "Evidencia",
      "type": "object"
    },
    "VotoJuri": {
      "additionalProperties": false,
      "description": "O voto de um membro do júri numa variável, numa rodada (1: votação; 2: deliberação).",
      "properties": {
        "evidencia": {
          "description": "Vazia no site publicado quando a licença do resumo não é aberta.",
          "title": "Evidencia",
          "type": "string"
        },
        "membro": {
          "title": "Membro",
          "type": "string"
        },
        "revisou": {
          "default": false,
          "description": "Na rodada 2: o membro mudou de valor na deliberação.",
          "title": "Revisou",
          "type": "boolean"
        },
        "rodada": {
          "enum": [
            1,
            2
          ],
          "title": "Rodada",
          "type": "integer"
        },
        "status": {
          "enum": [
            "literal",
            "aproximada",
            "ausente",
            "dispensada"
          ],
          "title": "Status",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valor"
        }
      },
      "required": [
        "membro",
        "rodada",
        "valor",
        "evidencia",
        "status"
      ],
      "title": "VotoJuri",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Um dos 64 fragmentos de detalhes, carregados sob demanda.",
  "properties": {
    "documentos": {
      "additionalProperties": {
        "$ref": "#/$defs/Detalhe"
      },
      "title": "Documentos",
      "type": "object"
    },
    "fragmento": {
      "title": "Fragmento",
      "type": "string"
    },
    "versao_contrato": {
      "default": "1.5",
      "description": "Versão do contrato. Versões 1.x só acrescentam campos: quem lê 1.0 lê qualquer 1.x.",
      "pattern": "^1\\.\\d+$",
      "title": "Versao Contrato",
      "type": "string"
    }
  },
  "required": [
    "fragmento",
    "documentos"
  ],
  "title": "Fragmento",
  "type": "object"
}
