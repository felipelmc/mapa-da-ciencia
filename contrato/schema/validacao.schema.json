{
  "$defs": {
    "AmostraInfo": {
      "additionalProperties": false,
      "description": "Como a amostra de validação foi sorteada.",
      "properties": {
        "estratificar_por": {
          "title": "Estratificar Por",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "semente": {
          "title": "Semente",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "estratificar_por",
        "semente"
      ],
      "title": "AmostraInfo",
      "type": "object"
    },
    "AuditoriaJuri": {
      "additionalProperties": false,
      "description": "A conferência, pelo supervisor, de uma amostra das decisões unânimes do júri.",
      "properties": {
        "erros": {
          "title": "Erros",
          "type": "integer"
        },
        "ic95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Intervalo de Wilson de 95% da taxa de erro.",
          "title": "Ic95"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "por_variavel": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "description": "Variável → (erros, n).",
          "title": "Por Variavel",
          "type": "object"
        },
        "taxa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Taxa"
        }
      },
      "required": [
        "n",
        "erros",
        "taxa",
        "ic95"
      ],
      "title": "AuditoriaJuri",
      "type": "object"
    },
    "ComparacaoModelos": {
      "additionalProperties": false,
      "description": "McNemar exato entre dois modelos, contra a mesma referência, numa variável.",
      "properties": {
        "acertos_a": {
          "title": "Acertos A",
          "type": "integer"
        },
        "acertos_b": {
          "title": "Acertos B",
          "type": "integer"
        },
        "modelo_a": {
          "title": "Modelo A",
          "type": "string"
        },
        "modelo_b": {
          "title": "Modelo B",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "p": {
          "title": "P",
          "type": "number"
        },
        "referencia": {
          "title": "Referencia",
          "type": "string"
        },
        "variavel": {
          "title": "Variavel",
          "type": "string"
        }
      },
      "required": [
        "variavel",
        "referencia",
        "modelo_a",
        "modelo_b",
        "n",
        "acertos_a",
        "acertos_b",
        "p"
      ],
      "title": "ComparacaoModelos",
      "type": "object"
    },
    "ConcordanciaSupervisor": {
      "additionalProperties": false,
      "description": "A concordância com a referência nas decisões sem maioria que o supervisor arbitrou, com a escolha dele.",
      "properties": {
        "acertos": {
          "title": "Acertos",
          "type": "integer"
        },
        "circular": {
          "description": "O supervisor e a referência são da mesma família: não é medida independente.",
          "title": "Circular",
          "type": "boolean"
        },
        "n": {
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "acertos",
        "circular"
      ],
      "title": "ConcordanciaSupervisor",
      "type": "object"
    },
    "Divergencia": {
      "additionalProperties": false,
      "description": "Um caso em que um codificador de referência e o modelo principal discordam, para arbitragem.",
      "properties": {
        "codificador": {
          "default": "",
          "title": "Codificador",
          "type": "string"
        },
        "doc": {
          "title": "Doc",
          "type": "string"
        },
        "evidencia": {
          "description": "Trecho que o modelo citou.",
          "title": "Evidencia",
          "type": "string"
        },
        "humano": {
          "description": "Valor dado pelo codificador (o nome do campo vem da versão 1.0).",
          "title": "Humano",
          "type": "string"
        },
        "incerto": {
          "default": false,
          "description": "O codificador marcou a resposta como incerta.",
          "title": "Incerto",
          "type": "boolean"
        },
        "modelo": {
          "title": "Modelo",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "literal",
                "aproximada",
                "ausente",
                "dispensada"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "variavel": {
          "title": "Variavel",
          "type": "string"
        }
      },
      "required": [
        "doc",
        "variavel",
        "humano",
        "modelo",
        "evidencia"
      ],
      "title": "Divergencia",
      "type": "object"
    },
    "Matriz": {
      "additionalProperties": false,
      "description": "Matriz de confusão entre dois participantes.",
      "properties": {
        "rotulos": {
          "items": {
            "type": "string"
          },
          "title": "Rotulos",
          "type": "array"
        },
        "valores": {
          "description": "Linhas = a referência do par; colunas = o outro participante.",
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Valores",
          "type": "array"
        }
      },
      "required": [
        "rotulos",
        "valores"
      ],
      "title": "Matriz",
      "type": "object"
    },
    "MetricaClasse": {
      "additionalProperties": false,
      "description": "Precisão, revocação e F1 de uma categoria, tomando o primeiro do par como referência.",
      "properties": {
        "f1": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "F1"
        },
        "precisao": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Precisao"
        },
        "revocacao": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revocacao"
        },
        "rotulo": {
          "title": "Rotulo",
          "type": "string"
        },
        "suporte": {
          "description": "Quantas vezes a referência deu esta categoria.",
          "title": "Suporte",
          "type": "integer"
        }
      },
      "required": [
        "rotulo",
        "suporte",
        "precisao",
        "revocacao",
        "f1"
      ],
      "title": "MetricaClasse",
      "type": "object"
    },
    "MetricaVariavel": {
      "additionalProperties": false,
      "description": "Concordância entre dois participantes (codificador × modelo, codificadores ou modelos) numa variável.\nNas de múltipla escolha, `variavel` é `id:categoria` (uma variável sim/não por categoria).",
      "properties": {
        "alfa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alfa"
        },
        "circular": {
          "default": false,
          "description": "Os dois participantes são da mesma família de modelo (a referência e o supervisor do júri, por exemplo): um limite superior, e não uma medida independente.",
          "title": "Circular",
          "type": "boolean"
        },
        "comparacao": {
          "description": "Ex.: `claude-opus × qwen3.5:9b` (referência primeiro).",
          "title": "Comparacao",
          "type": "string"
        },
        "comparado": {
          "default": "",
          "title": "Comparado",
          "type": "string"
        },
        "concordancia": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Concordancia"
        },
        "kappa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kappa"
        },
        "kappa_ic95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kappa Ic95"
        },
        "matriz": {
          "$ref": "#/$defs/Matriz"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "pabak": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pabak"
        },
        "por_classe": {
          "items": {
            "$ref": "#/$defs/MetricaClasse"
          },
          "title": "Por Classe",
          "type": "array"
        },
        "referencia": {
          "default": "",
          "description": "Participante tomado como referência (linhas da matriz).",
          "title": "Referencia",
          "type": "string"
        },
        "variavel": {
          "title": "Variavel",
          "type": "string"
        }
      },
      "required": [
        "variavel",
        "comparacao",
        "n",
        "concordancia",
        "kappa",
        "kappa_ic95",
        "pabak",
        "alfa",
        "matriz"
      ],
      "title": "MetricaVariavel",
      "type": "object"
    },
    "Participante": {
      "additionalProperties": false,
      "description": "Quem respondeu na amostra: um codificador (`humano` ou `referencia`, que não é uma pessoa) ou um modelo.",
      "properties": {
        "familia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Família de modelo, quando se conhece (ver `circular`).",
          "title": "Familia"
        },
        "n": {
          "description": "Documentos da amostra com resposta.",
          "title": "N",
          "type": "integer"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "tipo": {
          "enum": [
            "humano",
            "referencia",
            "modelo"
          ],
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "tipo",
        "n"
      ],
      "title": "Participante",
      "type": "object"
    },
    "ResumoJuri": {
      "additionalProperties": false,
      "description": "O júri de modelos locais na amostra: estágios, deliberação, concordância por estágio e auditoria.",
      "properties": {
        "auditoria": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditoriaJuri"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "concordancia_por_etapa": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Estágio → {n, acertos} contra a referência, com a decisão do júri sem o supervisor (no estágio `sem_maioria`, o voto do primeiro membro).",
          "title": "Concordancia Por Etapa",
          "type": "object"
        },
        "concordancia_supervisor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConcordanciaSupervisor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nas decisões sem maioria arbitradas, a concordância com a escolha do supervisor."
        },
        "deliberacao": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Membro → {votos, mudou, para_referencia, contra}: votos revistos na deliberação e a direção.",
          "title": "Deliberacao",
          "type": "object"
        },
        "documentos": {
          "title": "Documentos",
          "type": "integer"
        },
        "etapas": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Variável → estágio → decisões.",
          "title": "Etapas",
          "type": "object"
        },
        "familia_supervisor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Familia Supervisor"
        },
        "membros": {
          "items": {
            "type": "string"
          },
          "title": "Membros",
          "type": "array"
        },
        "referencia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "O codificador tomado como referência nas contagens.",
          "title": "Referencia"
        },
        "supervisor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supervisor"
        },
        "virou": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Variável → decisões que a deliberação mudou.",
          "title": "Virou",
          "type": "object"
        }
      },
      "required": [
        "referencia",
        "membros",
        "supervisor",
        "familia_supervisor",
        "documentos",
        "etapas"
      ],
      "title": "ResumoJuri",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resultados da validação da classificação: concordância por variável e por par de participantes.",
  "properties": {
    "amostra": {
      "$ref": "#/$defs/AmostraInfo"
    },
    "codificadores": {
      "description": "Participantes, com o tipo.",
      "items": {
        "$ref": "#/$defs/Participante"
      },
      "title": "Codificadores",
      "type": "array"
    },
    "comparacoes_modelos": {
      "items": {
        "$ref": "#/$defs/ComparacaoModelos"
      },
      "title": "Comparacoes Modelos",
      "type": "array"
    },
    "divergencias": {
      "items": {
        "$ref": "#/$defs/Divergencia"
      },
      "title": "Divergencias",
      "type": "array"
    },
    "evidencia_literal": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Modelo → fração das evidências literais na amostra.",
      "title": "Evidencia Literal",
      "type": "object"
    },
    "hash_codebook": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hash Codebook"
    },
    "juri": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResumoJuri"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "O júri de modelos locais, quando o projeto tem um."
    },
    "metricas": {
      "items": {
        "$ref": "#/$defs/MetricaVariavel"
      },
      "title": "Metricas",
      "type": "array"
    },
    "modelo_principal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modelo Principal"
    },
    "modelos": {
      "items": {
        "type": "string"
      },
      "title": "Modelos",
      "type": "array"
    },
    "versao_contrato": {
      "default": "1.5",
      "description": "Versão do contrato. Versões 1.x só acrescentam campos: quem lê 1.0 lê qualquer 1.x.",
      "pattern": "^1\\.\\d+$",
      "title": "Versao Contrato",
      "type": "string"
    }
  },
  "required": [
    "amostra",
    "metricas",
    "modelos",
    "divergencias"
  ],
  "title": "Validacao",
  "type": "object"
}
