{
  "$defs": {
    "Macrotema": {
      "additionalProperties": false,
      "description": "Agrupamento de tópicos próximos, usado para a cor e a navegação.",
      "properties": {
        "cor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Cor",
          "type": "string"
        },
        "descricao": {
          "default": "",
          "title": "Descricao",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "rotulo": {
          "title": "Rotulo",
          "type": "string"
        },
        "serie": {
          "anyOf": [
            {
              "$ref": "#/$defs/Serie"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Soma das séries dos tópicos do macrotema."
        },
        "tendencia": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tendencia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "topicos": {
          "items": {
            "type": "integer"
          },
          "title": "Topicos",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rotulo",
        "cor",
        "topicos"
      ],
      "title": "Macrotema",
      "type": "object"
    },
    "MetodoTendencia": {
      "additionalProperties": false,
      "description": "Como a tendência é calculada. O painel lê daqui os parâmetros para recalcular com os filtros.",
      "properties": {
        "anos_minimos": {
          "default": 5,
          "title": "Anos Minimos",
          "type": "integer"
        },
        "dispersao": {
          "default": "quase",
          "enum": [
            "quase",
            "binomial"
          ],
          "title": "Dispersao",
          "type": "string"
        },
        "docs_minimos": {
          "default": 10,
          "title": "Docs Minimos",
          "type": "integer"
        },
        "modelo": {
          "const": "logistica_binomial",
          "default": "logistica_binomial",
          "title": "Modelo",
          "type": "string"
        },
        "nivel": {
          "default": 0.95,
          "title": "Nivel",
          "type": "number"
        },
        "z": {
          "default": 1.959963984540054,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "MetodoTendencia",
      "type": "object"
    },
    "Outliers": {
      "additionalProperties": false,
      "description": "Documentos que o agrupamento não encaixou em nenhum tópico.",
      "properties": {
        "n": {
          "description": "Documentos que o HDBSCAN deixou sem tópico.",
          "title": "N",
          "type": "integer"
        },
        "por_ano": {
          "description": "Documentos que o HDBSCAN deixou de fora, por ano (inclui os reatribuídos depois), alinhado a `anos`.",
          "items": {
            "type": "integer"
          },
          "title": "Por Ano",
          "type": "array"
        },
        "reatribuidos": {
          "description": "Quantos deles foram atribuídos ao tópico mais próximo.",
          "title": "Reatribuidos",
          "type": "integer"
        },
        "sem_topico_por_ano": {
          "description": "Documentos que ficaram sem tópico (−1) no fim, por ano.",
          "items": {
            "type": "integer"
          },
          "title": "Sem Topico Por Ano",
          "type": "array"
        }
      },
      "required": [
        "n",
        "reatribuidos"
      ],
      "title": "Outliers",
      "type": "object"
    },
    "Serie": {
      "additionalProperties": false,
      "description": "Série temporal de um tópico.",
      "properties": {
        "n": {
          "description": "Documentos por ano, alinhado a `anos`.",
          "items": {
            "type": "integer"
          },
          "title": "N",
          "type": "array"
        },
        "prop": {
          "description": "Proporção do total do ano.",
          "items": {
            "type": "number"
          },
          "title": "Prop",
          "type": "array"
        }
      },
      "required": [
        "n",
        "prop"
      ],
      "title": "Serie",
      "type": "object"
    },
    "Tendencia": {
      "additionalProperties": false,
      "description": "Tendência da participação anual no período inteiro, sem filtros: o gabarito para o painel.",
      "properties": {
        "anos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anos"
        },
        "direcao": {
          "enum": [
            "alta",
            "queda",
            "estavel",
            "insuficiente"
          ],
          "title": "Direcao",
          "type": "string"
        },
        "dispersao": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "φ de Pearson (1 na binomial pura).",
          "title": "Dispersao"
        },
        "erro_padrao": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Erro-padrão da inclinação, já corrigido pela dispersão.",
          "title": "Erro Padrao"
        },
        "ic95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ic95"
        },
        "inclinacao": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclinação na escala logit, por ano.",
          "title": "Inclinacao"
        },
        "motivo": {
          "anyOf": [
            {
              "enum": [
                "poucos_anos",
                "poucos_documentos",
                "sem_variacao",
                "sem_convergencia"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Por que não há tendência, quando é `insuficiente`.",
          "title": "Motivo"
        },
        "pp_periodo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Variação em pontos percentuais no período.",
          "title": "Pp Periodo"
        },
        "pp_por_ano": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pp Por Ano"
        },
        "prop_fim": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participação ajustada no último ano com documentos.",
          "title": "Prop Fim"
        },
        "prop_inicio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Participação ajustada no primeiro ano com documentos.",
          "title": "Prop Inicio"
        }
      },
      "required": [
        "direcao"
      ],
      "title": "Tendencia",
      "type": "object"
    },
    "Topico": {
      "additionalProperties": false,
      "description": "Um tópico: rótulo e descrição escritos pelo LLM, palavras-chave, cor estável e série no tempo.",
      "properties": {
        "centroide": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Centroide",
          "type": "array"
        },
        "cor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Cor",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "macro_id": {
          "title": "Macro Id",
          "type": "integer"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "n_nucleo": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Documentos do núcleo, que o HDBSCAN agrupou (os demais foram reatribuídos por vizinhança).",
          "title": "N Nucleo"
        },
        "palavras_chave": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Palavras Chave",
          "type": "array"
        },
        "por_revista": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Por Revista",
          "type": "object"
        },
        "representativos": {
          "description": "Ids de documentos.",
          "items": {
            "type": "string"
          },
          "title": "Representativos",
          "type": "array"
        },
        "rotulo": {
          "title": "Rotulo",
          "type": "string"
        },
        "rotulo_fonte": {
          "default": "llm",
          "description": "Quem escreveu o rótulo: o modelo de linguagem, as palavras-chave ou você (rotulos.yaml).",
          "enum": [
            "llm",
            "palavras",
            "manual"
          ],
          "title": "Rotulo Fonte",
          "type": "string"
        },
        "serie": {
          "$ref": "#/$defs/Serie"
        },
        "tendencia": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tendencia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "macro_id",
        "rotulo",
        "descricao",
        "palavras_chave",
        "n",
        "centroide",
        "cor",
        "serie",
        "por_revista",
        "representativos"
      ],
      "title": "Topico",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Tópicos e macrotemas do corpus, com as séries por ano.",
  "properties": {
    "anos": {
      "items": {
        "type": "integer"
      },
      "title": "Anos",
      "type": "array"
    },
    "estabilidade_ari": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Estabilidade Ari"
    },
    "macrotemas": {
      "items": {
        "$ref": "#/$defs/Macrotema"
      },
      "title": "Macrotemas",
      "type": "array"
    },
    "metodo_tendencia": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetodoTendencia"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outliers": {
      "$ref": "#/$defs/Outliers"
    },
    "parametros": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Parametros",
      "type": "object"
    },
    "topicos": {
      "items": {
        "$ref": "#/$defs/Topico"
      },
      "title": "Topicos",
      "type": "array"
    },
    "total_por_ano": {
      "items": {
        "type": "integer"
      },
      "title": "Total Por Ano",
      "type": "array"
    },
    "versao_contrato": {
      "default": "1.5",
      "description": "Versão do contrato. Versões 1.x só acrescentam campos: quem lê 1.0 lê qualquer 1.x.",
      "pattern": "^1\\.\\d+$",
      "title": "Versao Contrato",
      "type": "string"
    }
  },
  "required": [
    "anos",
    "total_por_ano",
    "parametros",
    "estabilidade_ari",
    "macrotemas",
    "topicos",
    "outliers"
  ],
  "title": "Topicos",
  "type": "object"
}
